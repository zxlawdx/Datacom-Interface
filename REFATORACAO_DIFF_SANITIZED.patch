-      <div class="noc-kv"><span class="noc-label">ONU ID</span><span class="noc-value">${onu.id}</span></div>
-      <div class="noc-kv"><span class="noc-label">Serial</span><span class="noc-value" style="color:${C.warning};">${onu.serial}</span></div>
