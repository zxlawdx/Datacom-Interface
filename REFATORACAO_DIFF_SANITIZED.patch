-function fillDeleteForm(onu) {
-  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
-  set("del-pon",    onu.pon);
-  set("del-id",     onu.id);
-  set("del-serial", onu.serial);
-  showToast(`ONU ${onu.id} · ${onu.serial} selecionada`);
-}
