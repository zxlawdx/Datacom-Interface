-def _parse_ipv4_info(output: str) -> dict:
-    """
-    Extrai os campos IPv4 do output de 'show interface gpon {pon} onu {id}'.
-
-    Campos lidos da OLT Datacom:
-        IPv4 mode            : Static | PPPoE | Not configured | ...
-        IPv4 address         : 192.168.1.100  (ou vazio)
-        IPv4 default gateway : 192.168.1.1    (ou vazio)
-        IPv4 VLAN            : 306            (ou vazio)
-        IPv4 CoS             : 0              (ou vazio)
-
-    Retorna:
-    {
-        "mode":            "Static" | "PPPoE" | "Not configured" | None,
-        "address":         "192.168.1.100" | None,
-        "gateway":         "192.168.1.1"   | None,
-        "vlan":            "306"           | None,
-        "cos":             "0"             | None,
-        "configured":      True | False,   # True = IP real presente na OLT
-        "source":          "olt" | "pppoe_bras" | "unknown",
-        "note":            str | None,     # mensagem amigável quando sem IP
-    }
-    """
-    def field(label: str) -> str | None:
-        m = re.search(rf"{re.escape(label)}\s*:\s*(.+)", output, re.IGNORECASE)
-        if not m:
-            return None
-        val = m.group(1).strip()
-        return val if val else None
-
-    mode    = field("IPv4 mode")
-    address = field("IPv4 address")
-    gateway = field("IPv4 default gateway")
-    vlan    = field("IPv4 VLAN")
-    cos     = field("IPv4 CoS")
-
-    # Normaliza mode
-    mode_lower = (mode or "").lower()
-    if not mode or mode_lower in ("not configured", "n/a", "none", "-", ""):
-        mode = "Not configured"
-
-    configured = _is_real_ipv4(address)
-
-    # Determina a origem do IP e gera nota amigável
-    if configured:
-        source = "olt"
-        note   = None
-    elif "pppoe" in mode_lower or "ppp" in mode_lower:
-        source = "pppoe_bras"
-        note   = "IP atribuído via PPPoE pelo BRAS — não visível na OLT."
-    elif mode_lower == "not configured":
-        source = "unknown"
-        note   = "Nenhum IP configurado diretamente na OLT. Cliente pode usar PPPoE via BRAS."
-    else:
-        source = "unknown"
-        note   = f"Modo '{mode}' — IP não disponível na OLT."
-
-    return {
-        "mode":       mode,
-        "address":    address if configured else None,
-        "gateway":    gateway if _is_real_ipv4(gateway) else None,
-        "vlan":       vlan    if (vlan and vlan not in ("N/A", "None", "-")) else None,
-        "cos":        cos     if (cos  and cos  not in ("N/A", "None", "-")) else None,
-        "configured": configured,
-        "source":     source,
-        "note":       note,
-    }
-
