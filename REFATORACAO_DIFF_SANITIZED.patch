-            "service_port": "123",
-            "vlans": ["100"],
-            "pppoe_sessions": [{ "session_id": "...", "mac": "..." }]
-        },
-        "raw_detail": "...",
-        "raw_service": "..."
-    }
-    """
-    d = request.data
-    missing = _require_fields(d, ["olt", "pon", "onu_id"])
-    if missing:
-        return Response(
-            {"error": f"Campos obrigatórios ausentes: {', '.join(missing)}"},
-            status=status.HTTP_400_BAD_REQUEST,
-        )
-
-    olt_name = d["olt"]
-    pon      = d["pon"]
-    onu_id   = int(d["onu_id"])
-
-    olt, err = _get_olt(olt_name)
-    if err:
-        return err
-
-    cmd_detail  = f"show interface gpon {pon} onu {onu_id}"
-    cmd_svcport = f'show running-config service-port | context-match "gpon {pon} onu {onu_id}"'
-    cmd_pppoe   = f"show pppoe intermediate-agent sessions interface gpon {pon}"
-
-    # Executa 2 chamadas SSH em paralelo para reduzir latência
-    def fetch_detail():
-        out_detail = _run(olt_name, _gc_show(olt, cmd_detail))
-        out_rss    = _run(olt_name, _gc_show(olt, f"show interface gpon {pon} onu {onu_id} rss"))
-
-        # Concatena os dois outputs em um só string
