-            _gc_show(olt, cmd_svcport) + _gc_show(olt, cmd_pppoe)
-            if _is_datacom_gc(olt)
-            else [cmd_svcport, cmd_pppoe]
-        )
-        return _run(olt_name, cmds)
-
-    with ThreadPoolExecutor(max_workers=2) as pool:
-        fut_detail  = pool.submit(fetch_detail)
-        fut_service = pool.submit(fetch_service)
-        raw_detail  = fut_detail.result()
-        raw_service = fut_service.result()
-
-    detail_output  = raw_detail.get("output", "")
-    service_output = raw_service.get("output", "")
-
-    parsed_detail  = _parse_onu_detail(detail_output)
-    parsed_service = _parse_service_info(service_output, onu_id)
-
-    return Response({
-        "detail":      parsed_detail,
-        "service":     parsed_service,
-        "raw_detail":  detail_output,
-        "raw_service": service_output,
-        "error":       raw_detail.get("error") or raw_service.get("error"),
