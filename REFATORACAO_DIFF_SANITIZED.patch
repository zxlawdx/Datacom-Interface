-function parseOLTToCards(html, container) {
-  if (!container) return;
-  container.innerHTML = "";
-
-  const sinalEl = document.getElementById("onu-sinal");
-  if (sinalEl) { sinalEl.textContent = "--"; sinalEl.style.color = ""; }
-
-  const clean = html.replace(/<br>/g, "\n").replace(/<[^>]+>/g, "");
-  const dataLines = clean.split("\n").slice(2).filter(l => l.trim());
-
-  if (!dataLines.length) {
-    container.innerHTML = `<div class="noc-empty" style="grid-column:1/-1;"><p>Nenhuma ONU encontrada</p></div>`;
-    return;
-  }
-
-  dataLines.forEach(line => {
-    const parts = line.trim().split(/\s+/);
-    if (parts.length < 4) return;
-
-    const onu = {
-      pon:    parts[0],
-      id:     parts[1],
-      serial: parts[2],
-      status: parts[3],
-      name:   parts.slice(5).join(" ") || "",
-    };
-
-    const isUp = onu.status.toLowerCase() === "up";
-    const card = document.createElement("div");
-    card.className = `noc-card status-${isUp ? "up" : "down"}`;
-    card.setAttribute("role", "button");
-    card.setAttribute("tabindex", "0");
-    card.dataset.onuId  = onu.id;
-    card.dataset.onuPon = onu.pon;
-
-    card.innerHTML = `
-      <div class="noc-kv" style="margin-bottom:6px;">
-        <div style="display:flex;align-items:center;gap:6px;">
-          <span style="font-size:9px;color:${C.dim};text-transform:uppercase;">PON</span>
-          <span style="font-size:10px;color:${C.accent};font-weight:700;">${onu.pon}</span>
-          <span style="font-size:9px;color:${C.dim};">·</span>
-          <span style="font-size:9px;color:${C.dim};">ID</span>
-          <span style="font-size:10px;color:${C.text};">${onu.id}</span>
-        </div>
-        ${statusBadge(onu.status)}
-      </div>
-
-      <div style="font-size:11px;font-weight:700;color:${C.warning};
-                  letter-spacing:.03em;margin-bottom:${onu.name ? "4px" : "0"};">
-        ${onu.serial}
-      </div>
-
-      ${onu.name ? `
-        <div style="font-size:9px;color:${C.success};
-                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
-                    padding-top:4px;border-top:1px solid ${C.border};margin-top:4px;">
-          ${onu.name}
-        </div>` : ""}
-    `;
-
-    const activate = () => {
-      document.querySelectorAll("#onu-output .noc-card").forEach(c => c.classList.remove("selected"));
-      card.classList.add("selected");
-      getSignal(getSelectedOlt(), onu.pon, onu.id);
-    };
-    card.addEventListener("click", activate);
-    card.addEventListener("keydown", e => {
-      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); activate(); }
-    });
-
-    container.appendChild(card);
-  });
-}
