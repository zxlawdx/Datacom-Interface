-def _parse_service_info(output: str, onu_id: int) -> dict:
-    """
-    Extrai service-port, VLANs e sessões PPPoE do output combinado.
-
-    Retorna:
-    {
-        "service_port": "123" | None,
-        "vlans": ["100", "200"],
-        "pppoe_sessions": [
-            {"session_id": "12345", "mac": "AA:BB:CC:DD:EE:FF"}
-        ]
-    }
-    """
-    if not output:
-        return {"service_port": None, "vlans": [], "pppoe_sessions": []}
-
-    # service-port
-    sp_match = re.search(r"service-port\s+(\d+)", output, re.IGNORECASE)
-    service_port = sp_match.group(1) if sp_match else None
-
-    # VLANs (deduplica, preserva ordem)
-    vlan_matches = re.findall(r"vlan-id\s+(\d+)", output, re.IGNORECASE)
-    seen = set()
-    vlans = [v for v in vlan_matches if not (v in seen or seen.add(v))]
-
-    # Sessões PPPoE
-    # Formato típico Datacom: "  1/1/1    5    35633    30:16:9D:0C:CD:0B"
-    # Filtra pela coluna onu_id (cols[1])
-    pppoe_sessions = []
-    for line in output.splitlines():
-        cols = line.strip().split()
-        if len(cols) >= 4 and cols[1] == str(onu_id):
-            mac_candidate = cols[3] if len(cols) > 3 else None
-            if mac_candidate and re.match(r"([0-9A-Fa-f]{2}[:\-]){5}[0-9A-Fa-f]{2}", mac_candidate):
-                pppoe_sessions.append({
-                    "session_id": cols[2],
-                    "mac": mac_candidate.upper(),
-                })
-
-    return {
-        "service_port": service_port,
-        "vlans": vlans,
-        "pppoe_sessions": pppoe_sessions,
-    }
